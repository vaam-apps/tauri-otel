{
  "name": "tauri-plugin-otel-api",
  "version": "0.1.0",
  "description": "The webview half of tauri-plugin-otel: an OpenTelemetry-JS span exporter, log forwarding and trace propagation over the Tauri IPC.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/vaam-apps/tauri-otel.git"
  },
  "type": "module",
  "types": "./dist-js/index.d.ts",
  "main": "./dist-js/index.cjs",
  "module": "./dist-js/index.js",
  "exports": {
    "types": "./dist-js/index.d.ts",
    "import": "./dist-js/index.js",
    "require": "./dist-js/index.cjs"
  },
  "files": [
    "dist-js",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "rollup -c",
    "prepare": "rollup -c",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@tauri-apps/api": "^2.0.0"
  },
  "peerDependencies": {
    "@opentelemetry/api": "^1.9.0"
  },
  "devDependencies": {
    "@opentelemetry/api": "^1.9.1",
    "@opentelemetry/context-async-hooks": "^2.11.0",
    "@opentelemetry/sdk-trace-base": "^2.11.0",
    "@rollup/plugin-typescript": "^12.1.2",
    "@types/node": "^22.20.4",
    "rollup": "^4.34.0",
    "tslib": "^2.8.1",
    "typescript": "^5.7.3",
    "vitest": "^3.0.0"
  }
}
